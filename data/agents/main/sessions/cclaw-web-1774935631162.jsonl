ndow()\n\nif not chrome_windows:\n    print(\"No Chrome windows found!\")\n    print(\"Make sure Chrome is open with the login page.\")\nelse:\n    print(f\"Found {len(chrome_windows)} Chrome window(s):\")\n    for hwnd, title, pid in chrome_windows:\n        print(f\"  PID {pid}: {title}\")\n    \n    # Bring the first Chrome window to foreground\n    hwnd, title, pid = chrome_windows[0]\n    print(f\"\\nActivating window: {title}\")\n    \n    # Try to restore and activate\n    win32gui.ShowWindow(hwnd, win32con.SW_RESTORE)\n    time.sleep(0.5)\n    win32gui.SetForegroundWindow(hwnd)\n    time.sleep(1)\n    \n    # Take screenshot after focusing\n    screenshot = pyautogui.screenshot()\n    screenshot.save('chrome_screenshot.png')\n    print(\"Screenshot saved to chrome_screenshot.png\")\n    \n    # Now use pyautogui to locate input fields\n    # Try to find input fields by their appearance\n    # Standard login pages have input fields in the center area\n    \n    # Get screen dimensions\n    screen_w, screen_h = pyautogui.size()\n    print(f\"Screen: {screen_w}x{screen_h}\")\n    \n    # Use pyautogui to locate on screen - try to find input-like regions\n    # We'll use a combination of clicking and tab navigation\n    \n    # Click in the middle of the screen to focus the webpage\n    click_x, click_y = screen_w // 2, screen_h // 2 - 80\n    print(f\"Clicking at ({click_x}, {click_y}) to focus username field\")\n    pyautogui.click(click_x, click_y)\n    time.sleep(0.5)\n    \n    # Clear any existing text and type username\n    pyautogui.hotkey('ctrl', 'a')\n    time.sleep(0.2)\n    pyautogui.press('delete')\n    time.sleep(0.2)\n    \n    print(\"Typing username: 18926879306\")\n    pyautogui.typewrite('18926879306', interval=0.08)\n    time.sleep(0.3)\n    \n    # Press Tab to go to password field\n    print(\"Pressing Tab to password field\")\n    pyautogui.press('tab')\n    time.sleep(0.3)\n    \n    # Clear any existing text\n    pyautogui.hotkey('ctrl',